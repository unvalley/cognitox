# Copy to .env to override defaults; the server and `just` both load it.
# Every value below is the built-in default.

# Port to listen on.
COGNITOX_PORT=9229

# "persistent" (default) writes a snapshot to COGNITOX_DATA_FILE;
# "memory" keeps all state in memory and loses it on exit.
COGNITOX_STORAGE_MODE=persistent
COGNITOX_DATA_FILE=cognitox-data.json

# Base URL for the JWT `iss` claim (<base>/<user pool id>) and OpenID discovery.
# Defaults to http://localhost:<COGNITOX_PORT>.
# COGNITOX_ISSUER_BASE_URL=http://localhost:9229

# JSON file of user pools and clients to create at startup with fixed IDs.
# COGNITOX_SEED_FILE=seed.json

# tracing filter; debug level also logs confirmation codes.
RUST_LOG=cognitox=info,tower_http=info
